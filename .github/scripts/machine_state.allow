# What machine_state.sh compare accepts as different after an uninstall.
#
# One entry per line: <kind> <added|removed> <extended regex matching the whole
# entry>. $HOME stands for the install user's home. Every entry says why it is not
# a leftover, or not collateral damage - an entry without a reason is a bug hidden
# from the check that exists to find it.

# The runner unpacks its diagnostics here and removes them again, on its own schedule.
home added $HOME/extracted(/.*)?
home removed $HOME/extracted(/.*)?

# rpm's database. Ansible's package_facts queries every package manager present, rpm
# included on the Ubuntu runners, and the CI runs setup.sh with sudo -E, so HOME is
# the runner's instead of root's. A Debian machine without rpm never gets one.
home added $HOME/\.rpmdb(/.*)?

# Homebrew keeps a log directory for each formula it installs and prunes them
# whenever it installs or removes something, so a formula the install added and the
# uninstall removed can leave its log behind for a while.
home removed $HOME/Library/Logs/Homebrew(/.*)?
home added $HOME/Library/Logs/Homebrew(/.*)?

# macOS's own agents (Siri, Apple Intelligence, Spotlight, Mail, device management)
# create their containers, preferences and stores in ~/Library the first time they
# run, which on a fresh runner is during any long job, and add and remove their own
# files in them as they go: the journal of Suggestions' database was there before a
# macOS 15 install and gone after its uninstall. Apple's names only:
# com.apple., group.com.apple. or an Apple team prefix (243LU875E5.groups.com.apple.
# is Podcasts), the UUID-named containers of its extensions, and the stores only
# macOS keeps, Siri's speech service log and the App Store's AppleMediaServices
# engagement data among them. A UUID-named container is
# accepted only as added: an extension of any program can have one, so one that
# disappears may be someone's data. LaunchAgents, where the installer writes, stays
# checked.
home added $HOME/Library/(Application Scripts|Containers|Group Containers|Daemon Containers)/((group\.|[0-9A-Z]{10}\.groups?\.)?com\.apple\.[^/]+|[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12})(/.*)?
home added $HOME/Library/Application Support/(com\.apple\.[^/]+|locationaccessstored)(/.*)?
home added $HOME/Library/HTTPStorages/com\.apple\.[^/]+(/.*)?
home added $HOME/Library/Preferences/(ByHost/)?com\.apple\.[^/]+\.plist
home added $HOME/Library/(AppleMediaServices|DuetExpertCenter|PersonalizationPortrait|PrivateCloudCompute|Suggestions|Metadata/CoreSpotlight|Logs/SiriTTSService)(/.*)?
home removed $HOME/Library/(Application Scripts|Containers|Group Containers|Daemon Containers)/(group\.|[0-9A-Z]{10}\.groups?\.)?com\.apple\.[^/]+(/.*)?
home removed $HOME/Library/Application Support/(com\.apple\.[^/]+|locationaccessstored)(/.*)?
home removed $HOME/Library/HTTPStorages/com\.apple\.[^/]+(/.*)?
home removed $HOME/Library/Preferences/(ByHost/)?com\.apple\.[^/]+\.plist
home removed $HOME/Library/(AppleMediaServices|DuetExpertCenter|PersonalizationPortrait|PrivateCloudCompute|Suggestions|Metadata/CoreSpotlight|Logs/SiriTTSService)(/.*)?

# Stores macOS keeps changing on its own schedule: the identity services park what
# they are about to delete in IdentityServices/delete and persist their own state
# beside it, Siri's asset framework keeps the previous copy of each log next to the
# current one, and Trial, Apple's experiment and asset delivery, replaces its asset
# store.
home added $HOME/Library/(IdentityServices|UnifiedAssetFramework|Trial)(/.*)?
home removed $HOME/Library/(IdentityServices|UnifiedAssetFramework|Trial)(/.*)?

# The TV app's library. macOS's media agents create it on their own: on a macOS 26
# runner, mid-job, together with the Podcasts container above.
home added $HOME/Movies/TV(/.*)?

# macOS keeps an HTTP store per program name; it appears the first time any python
# makes a request and belongs to the system, not to this installer.
home added $HOME/Library/HTTPStorages/python(/.*)?

# setup.sh builds the installer's own virtualenv as root, and pip keeps those wheels
# in root's cache so the next run does not download them again (REUSE_CACHED_ARTIFACTS).
# The CI restores that cache itself, so only the directory shows up here.
system added /root/\.cache
