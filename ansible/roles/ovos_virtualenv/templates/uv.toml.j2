# Managed by ovos-installer. Local edits may be overwritten.
#
# uv has no per-virtualenv configuration of its own, so the activate script points
# UV_CONFIG_FILE at this file. It cannot carry the constraints file - uv's [pip]
# table has no constraint key, which is why UV_CONSTRAINT is exported alongside it -
# but it does pin the resolution strategy, so an "uv pip install" here behaves the
# way the installer's own installs do rather than following whatever uv's default
# becomes.
[pip]
prerelease = "if-necessary"
