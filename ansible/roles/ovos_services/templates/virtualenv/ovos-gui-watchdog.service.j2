[Unit]
Documentation=https://github.com/OpenVoiceOS/ovos-installer/issues/646
Description=Open Voice OS - GUI memory watchdog
PartOf=ovos.service
After=ovos-gui.service

[Service]
{% set _ovos_system_scope = (ovos_installer_systemd_scope | default('user')) == 'system' %}
{% if _ovos_system_scope %}
# The same user as ovos-shell: it can kill the shell, and needs nothing more.
User={{ ovos_installer_user }}
Group={{ ovos_installer_group }}
Environment=HOME={{ ovos_installer_user_home }}
{% endif %}
# A percent sign starts a systemd specifier, hence the doubling.
ExecStart={{ ovos_services_venv_path }}/bin/ovos-gui-watchdog {{ ovos_services_gui_memory_limit | string | replace('%', '%%') }} ovos-gui.service {{ '--system' if _ovos_system_scope else '--user' }}
Restart=always
RestartSec=30s
# Exit status 2 is a limit the watchdog refuses: restarting cannot fix it.
RestartPreventExitStatus=2

[Install]
WantedBy=ovos.service
